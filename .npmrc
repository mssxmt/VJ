# ── Supply-chain hardening ──────────────────────────────────────────
# Block install-time lifecycle scripts (preinstall/postinstall/install).
# This is the exact execution vector of the Shai-Hulud keyv attack
# ("preinstall": "node setup.mjs"). Override per-install when a trusted
# package genuinely needs its build step:
#   npm install <pkg> --ignore-scripts=false
ignore-scripts=true

# Require and commit package-lock.json for reproducible, auditable installs.
package-lock=true

# Fail install when the active Node version violates package.json#engines.
engine-strict=true

# Pin the default registry so a compromised/redirected .npmrc upstairs
# can't silently point installs at an attacker-controlled mirror.
registry=https://registry.npmjs.org/

# Make `npm audit` exit non-zero on high or critical advisories.
audit-level=high

# Reduce noise — opt out of funding prompts.
fund=false
